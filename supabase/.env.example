# Copy to supabase/.env (untracked — see .gitignore) and fill in from the Supabase dashboard:
# Project Settings -> API for the three keys/URL, Project Settings -> Database for the connection
# details. Never commit real values here; this file only documents the shape.

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by apply_schema.py. Use the "Session pooler" host from
# Settings -> Database -> Connection string if your network blocks direct DB connections (port
# 5432 direct, or 6543 via the pooler — check which one the dashboard shows you).
SUPABASE_DB_HOST=db.xxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
